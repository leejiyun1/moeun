# Docker compose local default:
# - Browser -> frontend dev server/nginx
# - Frontend API calls -> /api/v1
# - Vite dev proxy -> backend container
VITE_API_URL=/api/v1
DEV_PROXY_TARGET=http://backend:8000

VITE_KAKAO_CLIENT_ID=
VITE_KAKAO_REDIRECT_URI=http://localhost/auth/kakao/callback
VITE_NAVER_CLIENT_ID=
VITE_NAVER_REDIRECT_URI=http://localhost/auth/naver/callback
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback
VITE_KAKAO_APP_KEY=
VITE_TOSS_PAYMENTS_CLIENT_KEY=
